# Base URL of the Django REST API as seen by the browser.
# Leave empty to use the Vite dev proxy (requests go to /api and are forwarded
# to VITE_PROXY_TARGET). Set it in production, e.g. https://api.example.com
VITE_API_BASE_URL=

# Only used by the Vite dev server proxy.
VITE_PROXY_TARGET=http://127.0.0.1:8000
